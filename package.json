{
  "name": "backlog-browser",
  "version": "0.1.0",
  "description": "One local URL for every Backlog.md project under a folder, with a toolbar to switch between them.",
  "license": "MIT",
  "author": "Jo\u00e3o Fernandes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joaofnds/backlog-browser.git"
  },
  "homepage": "https://github.com/joaofnds/backlog-browser#readme",
  "bugs": "https://github.com/joaofnds/backlog-browser/issues",
  "keywords": [
    "backlog",
    "backlog-md",
    "kanban",
    "cli",
    "bun"
  ],
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "bin": {
    "backlog-browser": "./bin/backlog-browser.js"
  },
  "scripts": {
    "build": "bun build --compile --outfile dist/backlog-browser src/cli.ts",
    "check": "bun run fmt && bun run lint && bun run typecheck && bun test",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "scan": "gitleaks dir --no-banner --redact . && gitleaks git --no-banner --redact .",
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/shell && tsc --noEmit -p bin"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.0"
}
